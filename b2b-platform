#!/usr/bin/env bash
set -Eeuo pipefail
INSTALL_DIR=/opt/b2b-platform
BOOTSTRAP_BASE=${BOOTSTRAP_BASE:-https://raw.githubusercontent.com/zgybkjcn-a11y/b2b-platform-bootstrap/main}
ENV_FILE=$INSTALL_DIR/.env
COMPOSE=(docker compose --project-directory "$INSTALL_DIR" --env-file "$ENV_FILE" -f "$INSTALL_DIR/compose.yml")
fail() { echo "ERROR: $*" >&2; exit 1; }
[[ $(id -u) -eq 0 ]] || fail "run with sudo"

env_get() { sed -n "s/^$1=//p" "$ENV_FILE" | tail -1; }
env_set() {
  local key=$1 value=$2 escaped
  escaped=$(printf '%s' "$value" | sed 's/[&|]/\\&/g')
  if grep -q "^$key=" "$ENV_FILE"; then sed -i "s|^$key=.*|$key=$escaped|" "$ENV_FILE"; else printf '%s=%s\n' "$key" "$value" >> "$ENV_FILE"; fi
  chmod 0600 "$ENV_FILE"
}
health() { curl -fsS --max-time 15 "$(env_get PUBLIC_ORIGIN)/health" >/dev/null; }
service_health_status() {
  local service=$1 container status
  container=$("${COMPOSE[@]}" ps -q "$service" 2>/dev/null | head -1)
  [[ -n $container ]] || return 1
  status=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$container" 2>/dev/null) || return 1
  printf '%s\n' "$status"
}
service_is_healthy() {
  [[ $(service_health_status "$1") == healthy ]]
}
wait_for_healthy() {
  local service=$1 timeout=${2:-240} elapsed=0 status
  while (( elapsed < timeout )); do
    service_is_healthy "$service" && return 0
    status=$(service_health_status "$service" 2>/dev/null || true)
    case $status in
      unhealthy|exited|dead)
        echo "FAIL $service became $status" >&2
        return 1
        ;;
    esac
    sleep 2
    elapsed=$((elapsed + 2))
  done
  echo "FAIL $service did not become healthy within ${timeout}s" >&2
  return 1
}
backup() {
  local token result id
  token=$(env_get BACKUP_SERVICE_TOKEN)
  result=$("${COMPOSE[@]}" exec -T backup wget -qO- --header="Authorization: Bearer $token" --post-data='' http://127.0.0.1:31004/backups)
  id=$(printf '%s' "$result" | sed -n 's/.*"id":"\([^"]*\)".*/\1/p' | head -1)
  [[ -n $id ]] || fail "backup creation failed"
  result=$("${COMPOSE[@]}" exec -T backup wget -qO- --header="Authorization: Bearer $token" --post-data='' "http://127.0.0.1:31004/backups/$id/verify")
  printf '%s' "$result" | grep -q '"verification":"valid"' || fail "backup verification failed"
  echo "Backup $id created and verified"
}
tenant_encryption_check() {
  local keyring active entry key_id encoded bytes active_found=false
  keyring=$(env_get TENANT_SETTINGS_ENCRYPTION_KEYS)
  active=$(env_get TENANT_SETTINGS_ACTIVE_KEY_ID); active=${active:-v1}
  if [[ -z $keyring ]]; then
    local legacy_key; legacy_key=$(env_get TENANT_SETTINGS_ENCRYPTION_KEY)
    [[ -n $legacy_key ]] && keyring="$active:$legacy_key"
  fi
  [[ $active =~ ^[A-Za-z0-9._-]{1,64}$ ]] || { echo "FAIL tenant settings active key id is invalid"; return 1; }
  [[ -n $keyring ]] || { echo "FAIL tenant settings encryption keyring is not configured"; return 1; }
  IFS=',' read -ra entries <<< "$keyring"
  for entry in "${entries[@]}"; do
    key_id=${entry%%:*}; encoded=${entry#*:}
    [[ $key_id =~ ^[A-Za-z0-9._-]{1,64}$ && $encoded != "$entry" && -n $encoded ]] || { echo "FAIL tenant settings encryption keyring format is invalid"; return 1; }
    if ! bytes=$(printf '%s' "$encoded" | base64 -d 2>/dev/null | wc -c); then
      echo "FAIL tenant settings encryption key $key_id is not valid Base64"; return 1
    fi
    [[ $bytes -eq 32 ]] || { echo "FAIL tenant settings encryption key $key_id must decode to 32 bytes"; return 1; }
    [[ $key_id == "$active" ]] && active_found=true
  done
  [[ $active_found == true ]] || { echo "FAIL active tenant settings key $active is missing from keyring"; return 1; }
  echo "OK tenant settings encryption keyring ($active)"
}
upgrade() {
  local next=${1:-} previous
  [[ $next =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "usage: b2b-platform upgrade vX.Y.Z"
  previous=$(env_get APP_VERSION)
  [[ $next != "$previous" ]] || { echo "Already on $next"; return; }
  restore_previous_application() {
    env_set APP_VERSION "$previous"
    "${COMPOSE[@]}" up -d api worker dispatcher backup web || return 1
    wait_for_healthy web
  }
  doctor
  backup
  if curl -fsSL "$BOOTSTRAP_BASE/versions/$next.json" | grep -Fq "\"$previous\""; then
    printf '%s\n' "$previous" > "$INSTALL_DIR/rollback-version"
  else
    rm -f "$INSTALL_DIR/rollback-version"
    echo "WARN release does not declare $previous schema-compatible; rollback will be disabled"
  fi
  env_set APP_VERSION "$next"
  if ! "${COMPOSE[@]}" pull api worker dispatcher backup web migrate || ! "${COMPOSE[@]}" run --rm migrate || ! "${COMPOSE[@]}" up -d api worker dispatcher backup web; then
    restore_previous_application || true
    fail "upgrade failed; application images restored to $previous"
  fi
  if ! wait_for_healthy web || ! health; then
    restore_previous_application || true
    fail "health check failed; application images restored to $previous (database was not downgraded)"
  fi
  echo "Upgraded to $next"
}
rollback() {
  [[ -f $INSTALL_DIR/rollback-version ]] || fail "no recorded rollback version"
  local target; target=$(<"$INSTALL_DIR/rollback-version")
  echo "Rollback never downgrades the database. Continue only when release notes declare schema compatibility."
  read -r -p "Type $target to continue: " confirmation
  [[ $confirmation == "$target" ]] || fail "cancelled"
  local current; current=$(env_get APP_VERSION); env_set APP_VERSION "$target"
  if ! "${COMPOSE[@]}" up -d api worker dispatcher backup web || ! health; then env_set APP_VERSION "$current"; "${COMPOSE[@]}" up -d api worker dispatcher backup web; fail "rollback health check failed"; fi
  printf '%s\n' "$current" > "$INSTALL_DIR/rollback-version"
  echo "Rolled back application images to $target"
}
doctor() {
  local failed=0 mode origin template
  mode=$(env_get DEPLOYMENT_MODE); origin=$(env_get PUBLIC_ORIGIN)
  # Caddy 模板与 DEPLOYMENT_MODE 解耦；旧安装没有 CADDY_TEMPLATE 时沿用 mode。
  template=$(env_get CADDY_TEMPLATE); template=${template:-$mode}
  [[ $(stat -c %a "$ENV_FILE") == 600 ]] || { echo "FAIL .env permissions must be 600"; failed=1; }
  [[ $mode == domain && $origin == https://* ]] || [[ $mode == ip && $origin == http://* ]] || { echo "FAIL deployment mode/origin mismatch"; failed=1; }
  case $template in
    domain|ip) ;;
    tunnel) [[ $mode == domain ]] || { echo "FAIL CADDY_TEMPLATE=tunnel requires DEPLOYMENT_MODE=domain"; failed=1; } ;;
    *) echo "FAIL invalid CADDY_TEMPLATE: $template"; failed=1 ;;
  esac
  if [[ -f $INSTALL_DIR/Caddyfile.$template ]]; then
    if cmp -s "$INSTALL_DIR/Caddyfile" "$INSTALL_DIR/Caddyfile.$template"; then
      echo "OK Caddyfile matches the $template template"
    else
      echo "FAIL Caddyfile drifted from Caddyfile.$template; run b2b-platform update to reinstall it"
      failed=1
    fi
  fi
  # cloudflared 可能不在本机（容器里或另一台机器），所以这里只 WARN；
  # 隧道真的断了会由下面的 public health 探活直接 FAIL。
  if [[ $template == tunnel ]]; then
    if systemctl is-active --quiet cloudflared 2>/dev/null; then
      echo "OK cloudflared is active"
    else
      echo "WARN cloudflared is not active on this host; the tunnel must reach http://127.0.0.1:$(env_get PUBLIC_HTTP_PORT)"
    fi
  fi
  "${COMPOSE[@]}" config -q || failed=1
  "${COMPOSE[@]}" ps
  health && echo "OK public health" || { echo "FAIL public health"; failed=1; }
  tenant_encryption_check || failed=1
  [[ -n $(env_get SMTP_HOST) ]] || echo "WARN SMTP is not configured; password reset and email alerts are unavailable"
  return "$failed"
}
configure_domain() {
  read -r -p "Domain: " host
  [[ $host =~ ^[A-Za-z0-9.-]+$ && $host == *.* ]] || fail "invalid domain"
  local server_ip; server_ip=$(hostname -I | awk '{print $1}')
  getent ahostsv4 "$host" | awk '{print $1}' | grep -Fxq "$server_ip" || fail "DNS does not point to $server_ip"
  for port in 80 443; do ss -H -ltn "sport = :$port" | grep -q . && fail "port $port is already in use" || true; done
  env_set DEPLOYMENT_MODE domain; env_set CADDY_TEMPLATE domain; env_set PUBLIC_HOST "$host"; env_set PUBLIC_HTTP_PORT 80; env_set PUBLIC_HTTPS_HOST 0.0.0.0; env_set PUBLIC_HTTPS_PORT 443; env_set PUBLIC_ORIGIN "https://$host"; env_set SESSION_COOKIE_SECURE true
  cp "$INSTALL_DIR/Caddyfile.domain" "$INSTALL_DIR/Caddyfile"
  "${COMPOSE[@]}" up -d --force-recreate api web caddy
  for _ in {1..30}; do health && { echo "Domain enabled: https://$host (existing sessions must sign in again)"; return; }; sleep 2; done
  fail "domain health check failed; inspect b2b-platform logs caddy"
}
# 隧道入口：TLS 由 Cloudflare 边缘终止，cloudflared 从本机回源到 Caddy 的高位端口。
# 应用侧仍是 domain 语义（HTTPS origin + Secure Cookie），只有 Caddy 模板不同，
# 所以这里不做 domain 模式那两项校验（解析必须等于本机 IP、80/443 必须空闲）——
# Cloudflare 代理后域名解析到边缘 IP，且隧道不需要任何入站端口。
configure_tunnel() {
  local host port current_port
  read -r -p "Tunnel hostname (example: app.example.com): " host
  [[ $host =~ ^[A-Za-z0-9.-]+$ && $host == *.* ]] || fail "invalid hostname"
  getent ahosts "$host" >/dev/null || echo "WARN $host does not resolve yet; create the tunnel DNS record before going live"
  current_port=$(env_get PUBLIC_HTTP_PORT); current_port=${current_port:-8080}
  read -r -p "Local HTTP port for cloudflared to reach [$current_port]: " port; port=${port:-$current_port}
  [[ $port =~ ^[0-9]+$ ]] && (( port >= 1024 && port <= 65535 )) || fail "tunnel port must be between 1024 and 65535"
  env_set DEPLOYMENT_MODE domain; env_set CADDY_TEMPLATE tunnel; env_set PUBLIC_HOST "$host"
  env_set PUBLIC_HTTP_PORT "$port"; env_set PUBLIC_HTTPS_HOST 127.0.0.1; env_set PUBLIC_HTTPS_PORT 44443
  env_set PUBLIC_ORIGIN "https://$host"; env_set SESSION_COOKIE_SECURE true
  cp "$INSTALL_DIR/Caddyfile.tunnel" "$INSTALL_DIR/Caddyfile"
  "${COMPOSE[@]}" up -d --force-recreate api worker dispatcher web caddy
  systemctl is-active --quiet cloudflared || printf 'WARN cloudflared is not active here; the tunnel must route\n  hostname: %s\n  service: http://127.0.0.1:%s\n' "$host" "$port"
  for _ in {1..30}; do health && { echo "Tunnel entry enabled: https://$host (existing sessions must sign in again)"; return; }; sleep 2; done
  fail "tunnel health check failed; inspect b2b-platform logs caddy and systemctl status cloudflared"
}
configure_smtp() {
  local host port secure user password from
  read -r -p "SMTP host: " host; read -r -p "SMTP port [587]: " port; port=${port:-587}
  read -r -p "Use TLS immediately (true for port 465, otherwise false) [false]: " secure; secure=${secure:-false}
  read -r -p "SMTP username: " user; read -r -s -p "SMTP password: " password; echo
  read -r -p "From address: " from
  [[ $from == *@*.* ]] || fail "invalid from address"
  env_set SMTP_HOST "$host"; env_set SMTP_PORT "$port"; env_set SMTP_SECURE "$secure"; env_set SMTP_USER "$user"; env_set SMTP_PASSWORD "$password"; env_set AUTH_EMAIL_FROM "$from"
  "${COMPOSE[@]}" up -d --force-recreate api worker
  echo "SMTP saved. Send a test from System Settings > Deployment check."
}

command=${1:-help}; shift || true
case "$command" in
  install) curl -fsSL https://raw.githubusercontent.com/zgybkjcn-a11y/b2b-platform-bootstrap/main/install.sh | bash -s -- "$@" ;;
  update)
    if [[ -n ${1:-} ]]; then "$INSTALL_DIR/update.sh" --version "$1"; else "$INSTALL_DIR/update.sh"; fi
    ;;
  status) "${COMPOSE[@]}" ps ;;
  doctor) doctor ;;
  logs) if [[ -n ${1:-} ]]; then "${COMPOSE[@]}" logs --tail=200 -f "$1"; else "${COMPOSE[@]}" logs --tail=200 -f; fi ;;
  configure) case ${1:-} in domain) configure_domain;; tunnel) configure_tunnel;; smtp) configure_smtp;; *) fail "configure requires domain, tunnel or smtp";; esac ;;
  backup) backup ;;
  upgrade) upgrade "${1:-}" ;;
  rollback) rollback ;;
  uninstall)
    if [[ ${1:-} == --purge-data ]]; then read -r -p "Type b2b-platform to permanently delete all data: " confirm; [[ $confirm == b2b-platform ]] || fail "cancelled"; "${COMPOSE[@]}" down -v; else "${COMPOSE[@]}" down; echo "Services stopped; volumes and configuration retained."; fi ;;
  *) echo "Usage: b2b-platform install|update [version]|status|doctor|logs [service]|configure domain|configure tunnel|configure smtp|backup|upgrade [version]|rollback|uninstall [--purge-data]" ;;
esac
