http://{$PUBLIC_HOST} {
  encode gzip zstd
  # Preserve authenticated report HTML through CDN email obfuscation.
  @report_html {
    path /report/*
    header Cookie *b2b_session=*
  }
  header @report_html {
    +Cache-Control "no-transform"
    match header Content-Type text/html*
  }
  @api {
    path /api/* /health
    not path /api/agent-requests /api/agent-requests/* /api/agent-site-tokens /api/agent-site-tokens/* /api/agent-security-audits /api/agent-security-audits/*
  }
  handle @api {
    reverse_proxy api:31001
  }
  handle {
    reverse_proxy web:31000
  }
  header {
    -Strict-Transport-Security
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}
