http://{$PUBLIC_HOST} {
  encode gzip zstd
  @api path /api/* /health
  handle @api { reverse_proxy api:31001 }
  handle { reverse_proxy web:31000 }
  header {
    -Strict-Transport-Security
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "strict-origin-when-cross-origin"
    -Server
  }
}
